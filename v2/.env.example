# Copy to .env (never commit .env). Passwords are also read by compose for the DB URLs:
# keep them URL-safe, e.g. `openssl rand -hex 24`.
BK_OWNER_DB_PASSWORD=change-me-owner
BK_APP_DB_PASSWORD=change-me-app
BK_PUBLIC_URL=https://bill.example.com
BK_ENVIRONMENT=production
BK_MCP_ENABLED=true
# AI clients may write; each token still needs mcp_enabled and the write scopes
BK_MCP_WRITE_ENABLED=true
# Sign-in for claude.ai / ChatGPT connectors (OAuth 2.1); requires the https BK_PUBLIC_URL above
BK_OAUTH_ENABLED=true
BK_LOG_LEVEL=INFO
# Optional AI 识别 for screenshots / PDFs (docs/15 §3.1). Files go from this server to Anthropic's API;
# the worker does the reading, so it must be running. Leave unset to keep the feature off.
# BK_AI_API_KEY=
# BK_AI_MODEL=claude-opus-5-5
# BK_AI_EFFORT=medium
# BK_AI_MAX_FILES=12
# BK_AI_DAILY_FILES=200
# Encrypts AI provider keys saved in 设置 → AI 模型 (docs/19 §1.1); at least 32 characters,
# e.g. `openssl rand -hex 32`. Changing it means re-entering every saved provider key.
# BK_MASTER_KEY=
# AI 助手 limits (docs/19 §3.1): model turns and tokens per run, dollars per run (needs model prices),
# runs per book and day (0 = no cap)
# BK_AGENT_MAX_TURNS=24
# BK_AGENT_MAX_TOKENS=400000
# BK_AGENT_RUN_BUDGET_USD=2
# BK_AGENT_DAILY_RUNS=100
# Compose-only settings (not read by the app)
COMPOSE_FILE=compose.yaml:compose.production.yaml
BK_IMAGE=book-keeper:2.1.0
# v1 holds 127.0.0.1:8000 on the current server until cutover
BK_HOST_PORT=8010
