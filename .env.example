APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/ledger.db
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
KNOWLEDGE_WORKER_INTERVAL_SECONDS=5
AI_UPLOAD_DIR=./data/ai-inputs
AI_MAX_FILES_PER_WORKFLOW=10
AI_MAX_FILE_SIZE_BYTES=26214400
AI_MAX_TOTAL_FILE_SIZE_BYTES=104857600
AI_FAILED_FILE_TTL_HOURS=24
SESSION_COOKIE_SECURE=false

# Default compatible AI endpoint. Keep the secret in OPENAI_API_KEY at runtime.
AI_DEFAULT_BASE_URL=https://api.aiaimax.com/v1
AI_DEFAULT_PROTOCOL=responses
AI_DEFAULT_MODEL=
AI_DEFAULT_EFFORT=medium
OPENAI_API_KEY=
EMBEDDING_API_KEY=

OPENEXCHANGERATES_APP_ID=
